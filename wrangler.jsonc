{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site","database_id": "444ce970-02ff-4d07-8cfe-cf44b53ab052",
		},
	],
	// Login sessions. Must be listed with its ID: `wrangler preview` (used for
	// PR preview builds) can't auto-provision it the way `wrangler deploy` does.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "3abbd86c4d6c448980bb39ecb90ddfbf",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger (also publishes scheduled posts). Hourly
	// keeps it well inside the free plan; every minute was 1,440 runs a day.
	"triggers": {
		"crons": ["0 * * * *"],
	},
}
